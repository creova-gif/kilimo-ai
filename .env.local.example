# Copy to `.env` (gitignored) to run the app against the LOCAL backend.
#   scripts/local-backend.sh up      # starts Supabase + edge functions in Docker
#   scripts/local-backend.sh env     # prints these two lines with the real local values
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<run scripts/local-backend.sh env>

# Optional (client-side weather). Leave empty to see the truthful "weather unavailable" state.
EXPO_PUBLIC_OPENWEATHER_API_KEY=
